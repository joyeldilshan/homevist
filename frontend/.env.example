# Copy this file to .env and adjust for your environment.
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to the browser.
# ANYTHING HERE IS PUBLIC once the app is built — never put a secret,
# API key or password in this file.

# ── Backend API ──────────────────────────────────────────────────
# Must include the /api suffix.
#   local   http://localhost:5000/api
#   Render  https://your-service.onrender.com/api
# If unset, the app falls back to http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# ── Demo mode (optional, OFF by default) ─────────────────────────
# "true" shows a "Try the demo" panel on the login page with one-click
# sign-in buttons for the four roles. Anything else, or unset, and the
# panel does not render and its account list is dropped from the build.
#
# Only enable this on a throwaway demo deployment pointed at a SEEDED
# DEVELOPMENT database. Never on a real one.
VITE_DEMO_MODE=false

# Optional password for those one-click buttons.
#
# LEAVE BLANK unless this is a demo deployment. Vite inlines VITE_*
# variables into the built bundle, so whatever you put here is PUBLIC to
# anyone who views the JavaScript.
#
# Blank: clicking a role fills in the email only, and the panel tells you
# to take the password from the output of `npm run seed`.
#
# To use it, seed with one shared password and put the same value here:
#   SEED_ADMIN_PASSWORD=... SEED_PATIENT_PASSWORD=... (etc.) npm run seed
VITE_DEMO_PASSWORD=
