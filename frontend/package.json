{
  "name": "homevisit-frontend",
  "version": "1.0.0",
  "description": "Home Visit Mobile Blood Testing Platform — React Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --test --test-reporter=spec e2e/lifecycle.e2e.mjs",
    "test:api": "node --test --test-reporter=spec e2e/api.e2e.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.39.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.24.0",
    "socket.io-client": "^4.7.5",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vitest": "^2.1.9"
  }
}
