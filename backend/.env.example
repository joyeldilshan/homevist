# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored. NEVER commit real credentials.
# Every value below is a placeholder.

# ── Database ─────────────────────────────────────────────────────
# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ── URLs ─────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
VERIFY_BASE_URL=http://localhost:5173/verify

# ── SMS (Twilio) ─────────────────────────────────────────────────
# Optional. Leave blank to run in mock mode (messages print to console).
# Use a UK sender number for UK recipients.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email (SMTP) ─────────────────────────────────────────────────
# Optional. Leave blank to run in mock mode (emails print to console).
# For Gmail use an App Password, not your account password.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Home Visit <noreply@example.com>

# ── Seed accounts ────────────────────────────────────────────────
# Optional. Passwords for the sample accounts created by `npm run seed`.
# Leave blank and the seed generates a strong random password for each
# account and prints it once. Never commit real passwords here.
SEED_ADMIN_PASSWORD=
SEED_PATIENT_PASSWORD=
SEED_PHLEBOTOMIST1_PASSWORD=
SEED_PHLEBOTOMIST2_PASSWORD=
SEED_LAB_PASSWORD=

# The seed deletes all users and test types. It refuses to run when
# NODE_ENV=production unless this is set to exactly "yes".
SEED_ALLOW_PRODUCTION=
