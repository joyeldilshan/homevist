# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored. NEVER commit real credentials.
# Every value below is a placeholder.

# ── Database ─────────────────────────────────────────────────────
# MongoDB Atlas connection string. For local development use a dev
# database name such as hemovisit_dev: outside NODE_ENV=production the
# server refuses names without dev, test, local, sandbox or staging.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hemovisit_dev?retryWrites=true&w=majority
# Set to exactly "true" to bypass that check for one run. Leave unset.
# ALLOW_NON_DEV_DB=

# ── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# How long a sign-in token stays valid. Accepts "15m", "12h", "7d" or a
# number of seconds. Default is 7d if unset. There is no refresh-token
# flow: when it expires the user signs in again. The token is held in
# sessionStorage, so it is also cleared whenever the browser tab closes.
JWT_EXPIRES_IN=7d

# ── URLs ─────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
VERIFY_BASE_URL=http://localhost:5173/verify

# ── SMS (Twilio) ─────────────────────────────────────────────────
# Optional. Leave blank to run in mock mode (messages print to console).
# Use a UK sender number for UK recipients.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email (Gmail) ────────────────────────────────────────────────
# All email is sent through Gmail, signed in as EMAIL_USER with an App
# Password (not the account password). The sender address patients see is
# always EMAIL_USER. Leave both blank for mock mode: emails are built but
# not sent.
EMAIL_USER=
EMAIL_PASS=
# Display name shown as the sender, e.g. HemoVisit. Name only: the address
# is always EMAIL_USER. Unset = each email's own default name.
EMAIL_FROM=HemoVisit
# Who receives the "new booking" alert. Unset = that alert fails (logged);
# patients' emails are unaffected.
ADMIN_EMAIL=

# ── Seed accounts ────────────────────────────────────────────────
# Optional. Passwords for the sample accounts created by `npm run seed`.
# Leave blank and the seed generates a strong random password for each
# account and prints it once. Never commit real passwords here.
SEED_ADMIN_PASSWORD=
SEED_PATIENT_PASSWORD=
SEED_PHLEBOTOMIST1_PASSWORD=
SEED_PHLEBOTOMIST2_PASSWORD=
SEED_LAB_PASSWORD=

# The seed deletes all users and test types. It always refuses when
# NODE_ENV=production; there is no override. To create real admin or lab
# accounts use `npm run create-user` instead.
